webservers:
  hosts:
    synth-vm:
      ansible_host: ${vm_host}
      ansible_user: ${vm_username}
      app_admin_user: ${vm_username}
      ansible_ssh_private_key_file: ~/.ssh/synthetic_uptime_monitor_azure

    y540-server:
      ansible_host: ${linux_server_host}
      ansible_user: ${linux_server_user}
      app_admin_user: ${linux_server_user}
      ansible_ssh_private_key_file: ~/.ssh/y540-server